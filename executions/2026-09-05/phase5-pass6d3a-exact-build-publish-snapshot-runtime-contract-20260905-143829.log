_subscription_text_signature= (config_type: 'str | None' = None) -> 'tuple[str, dict]'
========== _subscription_text SOURCE ==========
def _subscription_text(
    config_type: str | None = None,
) -> tuple[str, dict]:

    snapshot = (
        build_publish_snapshot(
            config_type=config_type
        )
    )


    lines = []

    for record in snapshot.configs:

        raw = record.get(
            "raw"
        )

        if not isinstance(
            raw,
            str,
        ):
            continue

        # raw is returned exactly as stored.
        lines.append(
            raw
        )


    text = "\n".join(
        lines
    )

    if text:
        text += "\n"


    metadata = {
        "policy_available":
            snapshot.policy_available,

        "total_configs":
            snapshot.total_configs,

        "publishable":
            snapshot.publishable,

        "suppressed":
            snapshot.suppressed,

        "missing_policy_record":
            snapshot.missing_policy_record,

        "config_type":
            config_type,
    }


    return text, metadata

